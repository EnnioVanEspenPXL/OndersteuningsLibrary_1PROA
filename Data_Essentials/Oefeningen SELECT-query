--Teams oefeningen
--1
SELECT
Naam + ' ' + Voorn AS Naam,
Maandsal * 12 AS [Huidige jaarsalaris],
Maandsal * 12 * 1.15 AS [Toekomstig jaarsalaris]
FROM
Medewerkers
WHERE
Maandsal > 3000

--2
SELECT
Naam + ' ' + Voorn AS Naam,
Maandsal * 12 AS [Huidige jaarsalaris],
Maandsal * 12 + 1000 AS [Toekomstig jaarsalaris]
FROM
Medewerkers
WHERE
functie = 'BOEKHOUDER'

