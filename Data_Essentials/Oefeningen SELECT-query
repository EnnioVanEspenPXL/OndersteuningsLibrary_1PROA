--Extra (Berekining totaal Maandloon)
SELECT
Naam + ' ' + Voorn AS Naam,
Maandsal AS Salaris,
Comm AS commisie,
coalesce(Maandsal + Comm, Maandsal, Comm) AS [Totaal maandloon]
FROM
Medewerkers
ORDER BY
[Totaal maandloon] DESC